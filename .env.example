# Copie para .env ao correr Simcag.IdentityService.Api a partir desta pasta (DotNetEnv.NoClobber().Load()).
# Em Development, JWT__SECRET pode faltar (segredo fixo de dev no código). Em Staging/Produção é obrigatório.

# PostgreSQL (obrigatório exceto ASPNETCORE_ENVIRONMENT=Testing — testes usam InMemory)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=identity_db;Username=postgres;Password=postgres
# Ao arrancar a API (não-Testing), migrações EF são aplicadas automaticamente (tabelas Users, RefreshTokens, …).

# HS256: mínimo 32 caracteres. Deve coincidir com JWT__SECRET / JWT__SECRET do gateway.
JWT__SECRET=ChangeThisSecretKey12345678901234567890

# Opcionais (defaults no Program se omitir)
# JWT__ISSUER=Simcag.IdentityService
# JWT__AUDIENCE=Simcag.Clients
# JWT__ACCESSTOKENEXPIRATIONMINUTES=15
# JWT__REFRESHTOKENEXPIRATIONDAYS=7

# RabbitMQ (RPC: notification-service → destinatários por tenant)
# RABBITMQ__HOST=localhost
# RABBITMQ__PORT=5672
# RABBITMQ__USERNAME=guest
# RABBITMQ__PASSWORD=guest
# RABBITMQ__VIRTUALHOST=/

# API HTTP interna (opcional — debug manual; notification usa RPC)
# SIMCAG_INTERNAL_API_KEY=
