# identity-service — dev local (fora do Docker)
# Em Docker/produção estas variáveis são definidas no docker-compose ou no ambiente.

# Porta fixa para dev local (alinhada com gateway .env → SERVICES__IDENTITY__URL=http://localhost:5001)
ASPNETCORE_URLS=http://localhost:5001
ASPNETCORE_ENVIRONMENT=Development

# JWT (deve coincidir com o gateway-service)
JWT__SECRET=Simcag.Dev.Jwt.NotForProduction.AlignWithIdentityService.01!
JWT__ISSUER=Simcag.IdentityService
JWT__AUDIENCE=Simcag.Clients

# PostgreSQL
DB__HOST=potato-server
DB__PORT=5432
DB__NAME=devdb
DB__USER=devuser
DB__PASSWORD=devpass
ConnectionStrings__DefaultConnection=Host=potato-server;Port=5432;Database=devdb;Username=devuser;Password=devpass

# RabbitMQ (convenção dupla para compatibilidade)
RABBITMQ__HOST=potato-server
RABBITMQ__PORT=5672
RABBITMQ__USERNAME=admin
RABBITMQ__PASSWORD=admin
RABBITMQ__VIRTUALHOST=/
